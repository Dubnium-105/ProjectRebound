    {"kind":"join_grant","owner":"one player joining one frozen seat","issuer":"matchlobby signer","purpose":"native admission; aud=project-rebound-match-client","ttl_source":"Backend/internal/matchlobby/service.go:join intent issuance","storage":"Rust private controller and Payload; never command line/frontend","rotation":"same intent idempotent; replacement intent increments authorized generation","revocation":"attempt end, newer generation, expiry, cancel/consume","source":"Backend/internal/matchlobby/token.go"},
    {"kind":"authority_session","owner":"one attempt authority session","issuer":"matchlobby.Service","purpose":"attempt heartbeat, reserve/confirm/release and cleanup","ttl_source":"attempt authority lease and cleanup lifecycle","storage":"private controller; hashed server secret","rotation":"authority recovery protocol only","revocation":"attempt end or world loss; cleanup credential retained only for cleanup","source":"Backend/internal/matchlobby/service.go"},
    {"kind":"relay_allocation_token","owner":"individual HOST or PEER endpoint","issuer":"relayregistry.TokenManager","purpose":"UDP bind and recipient-specific MAC; aud=game-relay","ttl_source":"Backend/internal/config/config.go:RelayRegistryConfig.RelayTokenTTL","storage":"SecretString to RelayClient; derived key zeroized on drop","rotation":"new allocation/migration with distinct per-recipient credentials","revocation":"allocation revoke, migration cleanup, expiry","source":"Backend/internal/relayregistry/token.go"},
    {"kind":"battlelog_capability","owner":"authorized match reporter","issuer":"p2pbattlelog.Service","purpose":"report evidence for one managed match only","ttl_source":"Backend/internal/config/config.go:P2PBattleLogConfig.CapabilityTTL","storage":"private capability; server hash","rotation":"fresh scoped capability","revocation":"match end, expiry, capability revocation","source":"Backend/internal/p2pbattlelog/service.go"},
    {"kind":"dedicated_registration","owner":"authorized dedicated operator","issuer":"gameserver.Service","purpose":"one instance registration","ttl_source":"Backend/internal/config/config.go:GameServerConfig.RegistrationTokenTTL","storage":"protected operator runtime; server hash","rotation":"single-use registration credential","revocation":"consumed registration or expiry","source":"Backend/internal/gameserverregistration/token.go"},
