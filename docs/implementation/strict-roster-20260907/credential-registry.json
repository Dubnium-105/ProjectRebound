    {"kind":"steam_ticket","owner":"Steam helper and AuthIdentity","issuer":"Steam","purpose":"platform identity bind and integrity challenge","ttl_source":"Steam ticket validity; no invented fixed TTL","storage":"memory only","rotation":"reacquire for the same Steam identity","revocation":"Steam ticket cancellation and process/session end","source":"Toolbox/src/security/auth.rs"},
    {"kind":"room_host","owner":"managed MatchLobby transport controller","issuer":"p2proom.Service","purpose":"authorized transport heartbeat/bootstrap only","ttl_source":"owning room lifecycle","storage":"controller SecretString; server protected value/hash","rotation":"managed host credential recovery","revocation":"room close/attempt cleanup","source":"Backend/internal/p2proom/service.go"},
