+fn wait_for_local_pawn_ready(
+    ctx: &mut LaunchCtx,
+    game_pid: u32,
+    pipe: &mut std::fs::File,
+    progress: &Progress,
+) -> Result<()> {
+    let deadline = Instant::now() + STRICT_PLAYABLE_TIMEOUT;
+    loop {
+        ctx.ensure_running(game_pid, "Member game client")?;
+        let request_id = format!("member-local-ready-{:032x}", rand::random::<u128>());
+        let status = crate::server::pipe::request_payload_status(
+            pipe,
+            &request_id,
+            STRICT_PIPE_RESPONSE_TIMEOUT,
+        )?;
+        let match_status = status.match_status.as_ref();
+        let native_state = match_status
+            .map(|value| value.state.as_str())
+            .unwrap_or("idle");
+        if status.status == "blocked" || matches!(native_state, "failed" | "cancelled") {
+            let detail = match_status
+                .map(|value| value.last_error.as_str())
+                .filter(|value| !value.is_empty())
+                .unwrap_or(status.code.as_str());
+            anyhow::bail!("Payload native client readiness was rejected: {detail}");
+        }
+        if match_status.is_some_and(|value| value.local_pawn_ready && value.native_net_ready) {
+            anyhow::ensure!(
+                status.status == "ready"
+                    && status.ready
+                    && status.strict_online_ready
+                    && !status.offline_pve
+                    && !status.native_authority_path_required
+                    && status.native_client_grant_injection_required
+                    && status.native_client_grant_injection_ready,
+                "Payload local pawn readiness lacks strict client capability proof"
+            );
+            anyhow::ensure!(
+                !match_status
+                    .map(|value| value.local_world_instance_id.trim().is_empty())
+                    .unwrap_or(true),
+                "Payload local pawn readiness omitted local world observation"
+            );
+            return Ok(());
+        }
+        set_progress(progress, 3, 3, &format!("Native match ({native_state})"));
+        anyhow::ensure!(
+            Instant::now() < deadline,
+            "Payload native client did not reach local pawn readiness within {} seconds",
+            STRICT_PLAYABLE_TIMEOUT.as_secs()
+        );
+        thread::sleep(Duration::from_millis(250));
+    }
+}
