{
  "annotations": {"list": []},
  "description": "Fleet-first operations view. Online relay cards repeat automatically from live control-plane telemetry.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Relay fleet",
      "description": "Registered inventory, scheduler-ready nodes, and live mTLS control streams.",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "count(relay_node_info) or vector(0)", "legendFormat": "Registered"},
        {"expr": "sum(relay_node_state{state=\"READY\"}) or vector(0)", "legendFormat": "Ready"},
        {"expr": "sum(relay_node_control_connected) or vector(0)", "legendFormat": "Online"},
        {"expr": "sum(relay_node_state{state=~\"UNHEALTHY|OFFLINE\"}) or vector(0)", "legendFormat": "Unavailable"}
      ],
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "decimals": 0},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Online"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byName", "options": "Unavailable"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "orientation": "horizontal", "textMode": "auto", "colorMode": "value", "graphMode": "none"},
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Live workload",
      "description": "Current application workload and relay capacity consumption.",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "active_sessions", "legendFormat": "Sessions"},
        {"expr": "p2p_rooms_active", "legendFormat": "P2P rooms"},
        {"expr": "relay_allocations_active", "legendFormat": "Allocations"},
        {"expr": "100 * sum(relay_node_active_allocations) / clamp_min(sum(relay_node_max_allocations), 1)", "legendFormat": "Fleet capacity"}
      ],
      "fieldConfig": {
        "defaults": {"decimals": 0},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Fleet capacity"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "min", "value": 0}, {"id": "max", "value": 100}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}]}
        ]
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "orientation": "horizontal", "textMode": "auto", "colorMode": "value", "graphMode": "none"},
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Service targets",
      "description": "Prometheus target health for the control plane, relays, and node exporters.",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "up{job=~\"project-rebound-control-plane|project-rebound-edge-relay|project-rebound-node.*\"}", "legendFormat": "{{job}} / {{instance}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "orientation": "horizontal", "textMode": "auto", "colorMode": "background", "graphMode": "none"},
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "$online_relay",
      "description": "This card repeats automatically for every relay with an active mTLS control stream.",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "repeat": "online_relay",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "targets": [
        {"expr": "relay_node_control_connected{display_name=~\"$online_relay\"}", "legendFormat": "mTLS"},
        {"expr": "relay_node_active_allocations{display_name=~\"$online_relay\"}", "legendFormat": "Allocations"},
        {"expr": "100 * relay_node_active_allocations{display_name=~\"$online_relay\"} / clamp_min(relay_node_max_allocations{display_name=~\"$online_relay\"}, 1)", "legendFormat": "Capacity"},
        {"expr": "relay_node_telemetry_report_age_seconds{display_name=~\"$online_relay\"}", "legendFormat": "Telemetry age"}
      ],
      "fieldConfig": {
        "defaults": {"decimals": 0},
        "overrides": [
          {"matcher": {"id": "byName", "options": "mTLS"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "DISCONNECTED", "color": "red"}, "1": {"text": "CONNECTED", "color": "green"}}}]}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}]},
          {"matcher": {"id": "byName", "options": "Capacity"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "min", "value": 0}, {"id": "max", "value": 100}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}]},
          {"matcher": {"id": "byName", "options": "Telemetry age"}, "properties": [{"id": "unit", "value": "s"}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 30}, {"color": "red", "value": 60}]}}]}
        ]
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "orientation": "horizontal", "textMode": "auto", "colorMode": "value", "graphMode": "area", "wideLayout": true},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 5}
    },
    {
      "id": 5,
      "type": "table",
      "title": "Relay inventory — all registered nodes",
      "description": "Includes online, offline, and revoked nodes. mTLS is derived from the current control-stream state.",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "relay_node_state * on(node_id) group_left() relay_node_control_connected", "legendFormat": "{{display_name}}", "instant": true, "format": "table"}
      ],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true}, "indexByName": {"display_name": 0, "state": 1, "region": 2, "zone": 3, "provider": 4, "node_id": 5, "Value": 6}, "renameByName": {"display_name": "Node", "state": "State", "region": "Region", "zone": "Zone", "provider": "Provider", "node_id": "Node ID", "Value": "mTLS"}}}
      ],
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "mTLS"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "DISCONNECTED", "color": "red"}, "1": {"text": "CONNECTED", "color": "green"}}}]}, {"id": "custom.cellOptions", "value": {"type": "color-text"}}]}
        ]
      },
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 12}
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Relay capacity by node",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "100 * relay_node_active_allocations / clamp_min(relay_node_max_allocations, 1) and on(node_id) (relay_node_control_connected == 1)", "legendFormat": "{{display_name}} / {{region}}", "instant": true}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "showUnfilled": true},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Relay heartbeat and telemetry freshness",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "relay_node_heartbeat_age_seconds and on(node_id) (relay_node_control_connected == 1)", "legendFormat": "{{display_name}} heartbeat"},
        {"expr": "relay_node_telemetry_report_age_seconds and on(node_id) (relay_node_control_connected == 1)", "legendFormat": "{{display_name}} telemetry"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 30}, {"color": "red", "value": 60}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Relay throughput by node",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "sum by (display_name, region) (rate(relay_node_bytes_forwarded_total[5m])) * 8", "legendFormat": "{{display_name}} / {{region}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Relay packet rate by node",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "sum by (display_name, region) (rate(relay_node_packets_received_total[5m]))", "legendFormat": "{{display_name}} received"},
        {"expr": "sum by (display_name, region) (rate(relay_node_packets_forwarded_total[5m]))", "legendFormat": "{{display_name}} forwarded"},
        {"expr": "sum by (display_name, region) (rate(relay_node_packets_dropped_total[5m]))", "legendFormat": "{{display_name}} dropped"}
      ],
      "fieldConfig": {"defaults": {"unit": "pps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Relay validation and throttling",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "sum by (display_name) (rate(relay_node_bind_failed_total[5m]))", "legendFormat": "{{display_name}} bind failures"},
        {"expr": "sum by (display_name) (rate(relay_node_token_invalid_total[5m]))", "legendFormat": "{{display_name}} invalid tokens"},
        {"expr": "sum by (display_name) (rate(relay_node_rate_limit_drops_total[5m]))", "legendFormat": "{{display_name}} rate-limit drops"},
        {"expr": "sum by (display_name) (rate(relay_node_control_reconnects_total[5m]))", "legendFormat": "{{display_name}} reconnects"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 37}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP request rate",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "sum(rate(http_requests_total[5m])) by (route, status)", "legendFormat": "{{route}} · {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 45}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP P95 latency",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 45}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Security and allocation failures",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "rate(auth_bind_failed_total[5m])", "legendFormat": "Bind failures"},
        {"expr": "rate(refresh_token_reuse_total[5m])", "legendFormat": "Refresh reuse"},
        {"expr": "rate(relay_allocation_failed_total[5m])", "legendFormat": "Allocation failures"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 53}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Database pool connections",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "database_pool_connections", "legendFormat": "{{state}}"}],
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 53}
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Host CPU usage",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{job=~\"project-rebound-node.*\",mode=\"idle\"}[5m])) * 100", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 61}
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Host memory usage",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "(1 - node_memory_MemAvailable_bytes{job=~\"project-rebound-node.*\"} / node_memory_MemTotal_bytes{job=~\"project-rebound-node.*\"}) * 100", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 61}
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Root filesystem usage",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{job=~\"project-rebound-node.*\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=~\"project-rebound-node.*\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 61}
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Host network throughput",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "sum by (instance) (rate(node_network_receive_bytes_total{job=~\"project-rebound-node.*\",device!~\"lo|docker.*|veth.*\"}[5m])) * 8", "legendFormat": "{{instance}} RX"},
        {"expr": "sum by (instance) (rate(node_network_transmit_bytes_total{job=~\"project-rebound-node.*\",device!~\"lo|docker.*|veth.*\"}[5m])) * 8", "legendFormat": "{{instance}} TX"}
      ],
      "fieldConfig": {"defaults": {"unit": "bps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 69}
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["project-rebound", "production", "relay-fleet"],
  "templating": {
    "list": [
      {
        "name": "online_relay",
        "label": "Online relay",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
        "definition": "query_result(relay_node_control_connected == 1)",
        "query": {"query": "query_result(relay_node_control_connected == 1)", "refId": "StandardVariableQuery"},
        "regex": "/display_name=\"([^\"]+)\"/",
        "sort": 1,
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 2,
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "15s", "30s", "1m", "5m"]},
  "timezone": "browser",
  "title": "Project Rebound Operations",
  "uid": "project-rebound-control-plane",
  "version": 4
}
