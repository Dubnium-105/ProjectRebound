{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Service targets",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "up{job=~\"project-rebound-control-plane|project-rebound-edge-relay|project-rebound-node.*\"}", "legendFormat": "{{job}} / {{instance}}"}
      ],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto"},
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Control plane state",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "active_sessions", "legendFormat": "Sessions"},
        {"expr": "p2p_rooms_active", "legendFormat": "P2P rooms"},
        {"expr": "relay_allocations_active", "legendFormat": "Relay allocations"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "orientation": "horizontal", "textMode": "auto"},
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0}
    },
    {
      "type": "stat",
      "title": "Registered relay state",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "count(relay_node_info) or vector(0)", "legendFormat": "Registered"},
        {"expr": "sum(relay_node_state{state=\"READY\"}) or vector(0)", "legendFormat": "Ready"},
        {"expr": "sum(relay_node_control_connected) or vector(0)", "legendFormat": "mTLS connected"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "orientation": "horizontal", "textMode": "auto"},
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "sum(rate(http_requests_total[5m])) by (route, status)", "legendFormat": "{{route}} {{status}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}
    },
    {
      "type": "timeseries",
      "title": "HTTP P95 latency",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}
    },
    {
      "type": "timeseries",
      "title": "Security and allocation failures",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "rate(auth_bind_failed_total[5m])", "legendFormat": "Bind failures"},
        {"expr": "rate(refresh_token_reuse_total[5m])", "legendFormat": "Refresh reuse"},
        {"expr": "rate(relay_allocation_failed_total[5m])", "legendFormat": "Allocation failures"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 13}
    },
    {
      "type": "timeseries",
      "title": "Relay packet rate",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "sum by (display_name, region) (rate(relay_node_packets_received_total[5m]))", "legendFormat": "{{display_name}} / {{region}} received"},
        {"expr": "sum by (display_name, region) (rate(relay_node_packets_forwarded_total[5m]))", "legendFormat": "{{display_name}} / {{region}} forwarded"},
        {"expr": "sum by (display_name, region) (rate(relay_node_packets_dropped_total[5m]))", "legendFormat": "{{display_name}} / {{region}} dropped"}
      ],
      "fieldConfig": {"defaults": {"unit": "pps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 13}
    },
    {
      "type": "timeseries",
      "title": "Relay traffic and validation",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "sum by (display_name, region) (rate(relay_node_bytes_forwarded_total[5m])) * 8", "legendFormat": "{{display_name}} / {{region}} bits/s"},
        {"expr": "sum by (display_name, region) (rate(relay_node_bind_failed_total[5m]))", "legendFormat": "{{display_name}} bind failures/s"},
        {"expr": "sum by (display_name, region) (rate(relay_node_token_invalid_total[5m]))", "legendFormat": "{{display_name}} invalid tokens/s"},
        {"expr": "sum by (display_name, region) (rate(relay_node_rate_limit_drops_total[5m]))", "legendFormat": "{{display_name}} rate-limit drops/s"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 13}
    },
    {
      "type": "timeseries",
      "title": "Host CPU usage",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{job=~\"project-rebound-node.*\",mode=\"idle\"}[5m])) * 100", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 21}
    },
    {
      "type": "timeseries",
      "title": "Host memory usage",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "(1 - node_memory_MemAvailable_bytes{job=~\"project-rebound-node.*\"} / node_memory_MemTotal_bytes{job=~\"project-rebound-node.*\"}) * 100", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 21}
    },
    {
      "type": "timeseries",
      "title": "Root filesystem usage",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{job=~\"project-rebound-node.*\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=~\"project-rebound-node.*\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 21}
    },
    {
      "type": "timeseries",
      "title": "Database pool connections",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "database_pool_connections", "legendFormat": "{{state}}"}],
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 29}
    },
    {
      "type": "table",
      "title": "Registered relay inventory",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [{"expr": "relay_node_state", "legendFormat": "{{display_name}}", "instant": true, "format": "table"}],
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 29}
    },
    {
      "type": "timeseries",
      "title": "Host network throughput",
      "datasource": {"type": "prometheus", "uid": "project-rebound-prometheus"},
      "targets": [
        {"expr": "sum by (instance) (rate(node_network_receive_bytes_total{job=~\"project-rebound-node.*\",device!~\"lo|docker.*|veth.*\"}[5m])) * 8", "legendFormat": "{{instance}} RX"},
        {"expr": "sum by (instance) (rate(node_network_transmit_bytes_total{job=~\"project-rebound-node.*\",device!~\"lo|docker.*|veth.*\"}[5m])) * 8", "legendFormat": "{{instance}} TX"}
      ],
      "fieldConfig": {"defaults": {"unit": "bps"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 29}
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["project-rebound", "production"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Project Rebound Operations",
  "uid": "project-rebound-control-plane",
  "version": 3
}
