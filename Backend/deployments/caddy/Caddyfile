:8080 {
	encode zstd gzip
	handle /internal/v1/relay-nodes/enroll {
		reverse_proxy control-plane:8080
	}
	handle /internal/v1/relay-nodes/*/certificate/renew {
		reverse_proxy control-plane:8080
	}
	handle /internal/* {
		respond 404
	}
	handle /v1/admin* {
		respond 404
	}
	handle {
		reverse_proxy control-plane:8080
	}
}

:8081 {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' http://minio.localhost:9000; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' data:; object-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; worker-src 'self'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		-Server
	}

	# Worker response headers include CSP, so revalidate them independently of
	# the content-hashed JavaScript cache lifetime.
	@hash_worker path /assets/sha256.worker-*.js
	header @hash_worker >Cache-Control "public, max-age=0, must-revalidate"

	handle /v1/admin* {
		reverse_proxy control-plane:8080
	}
	handle {
		reverse_proxy admin-web:8080
	}
}
