# This file contains local development defaults only. Do not put production
# credentials or signing keys in Compose environment files.
POSTGRES_DB=projectrebound
POSTGRES_USER=projectrebound
POSTGRES_PASSWORD=projectrebound_dev
# Generate a unique Ed25519 key for non-development environments and provide
# it through the deployment secret store, never through this file.
# ACCESS_TOKEN_PRIVATE_KEY_BASE64=
# Keep disabled unless the exact locked Boundary build and signed ToolBox are installed.
STRICT_ROSTER_V1_ENABLED=false
STRICT_ROSTER_LOCKED_GAME_SHA256=181c49ffb522b3eb01014c84fd9d3a2a5c0b66ae80a6a6addff4bdd6f8125843
# MATCH_ADMISSION_SIGNING_KEY_ID=match-admission-dev
# MATCH_ADMISSION_PRIVATE_KEY_BASE64=
# ADMIN_TOKENS=operator=replace-with-at-least-32-random-characters
# ADMIN_ACCESS_TOKEN_KEY_ID=admin-access-signing-key-2026-01
# ADMIN_ACCESS_TOKEN_PRIVATE_KEY_BASE64=
# ADMIN_MFA_ENCRYPTION_KEY_BASE64=
# Cloudflare official always-pass test keys are the Compose development
# defaults. Never reuse them in staging or production.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_EXPECTED_HOSTNAME=localhost
# TURNSTILE_EXPECTED_ACTION=admin_login
# GAME_SERVER_CA_CERT_PEM_BASE64=
# GAME_SERVER_CA_KEY_PEM_BASE64=
# VNT_SECRET_ENCRYPTION_KEY_BASE64=
VNT_SECRET_ENCRYPTION_KEY_ID=vnt-room-v1
# VNT_SECRET_DECRYPTION_KEYS=old-key-id=BASE64_OLD_32_BYTE_KEY
VNT_ROOMS_ENABLED=false
VNT_CREDENTIAL_ROTATION_GRACE_SECONDS=60
VNT_ENROLLMENT_REQUESTS_PER_PLAYER_PER_HOUR=5
VNT_DIRECTORY_REQUESTS_PER_IP_PER_MINUTE=120
VNT_BOOTSTRAP_REQUESTS_PER_PLAYER_PER_MINUTE=30
VNT_HEARTBEAT_REQUESTS_PER_CREDENTIAL_PER_MINUTE=120
VNT_MANAGEMENT_REQUESTS_PER_CREDENTIAL_PER_HOUR=10
VNT_MAX_NODES_PER_PLAYER=3
# RELAY_BOOTSTRAP_TOKENS=relay-dev=replace-with-at-least-32-random-characters
# EDGE_RELAY_BOOTSTRAP_TOKEN=use-the-token-value-from-RELAY_BOOTSTRAP_TOKENS
# RELAY_CA_CERT_PEM_BASE64=
# RELAY_CA_KEY_PEM_BASE64=
# RELAY_TOKEN_KEY_ID=relay-signing-key-2026-01
# RELAY_TOKEN_PRIVATE_KEY_BASE64=
# UPDATE_SIGNING_KEY_ID=update-signing-key-2026-01
# UPDATE_SIGNING_PRIVATE_KEY_BASE64=
# Local monitoring profile only. Override both values before sharing access.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-for-local-monitoring
