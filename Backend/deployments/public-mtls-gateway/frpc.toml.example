user = "projectrebound"
serverAddr = "GATEWAY_IPV4"
serverPort = 7000
loginFailExit = false

transport.wireProtocol = "v2"
transport.tls.enable = true
transport.tcpMux = true

auth.method = "token"
auth.token = "CHANGE_ME"
auth.additionalScopes = ["HeartBeats", "NewWorkConns"]

log.to = "console"
log.level = "info"
log.disablePrintColor = true

[[proxies]]
name = "control-mtls"
type = "tcp"
localIP = "127.0.0.1"
localPort = 9090
remotePort = 443
transport.useEncryption = true
