{$PUBLIC_API_SITE:http://:80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Relay enrollment and certificate renewal are machine-facing endpoints.
	handle /internal/v1/relay-nodes/enroll {
		reverse_proxy control-plane:8080
	}
	handle /internal/v1/relay-nodes/*/certificate/renew {
		reverse_proxy control-plane:8080
	}

	# Administrator, monitoring, and other internal routes are never public.
	handle /internal/* {
		respond 404
	}
	handle /v1/admin* {
		respond 404
	}

	handle {
		reverse_proxy control-plane:8080
	}
}

{$ADMIN_WEB_SITE:admin.example.com} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://{$MINIO_S3_SITE:s3.example.com}; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' data:; object-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; worker-src 'self'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		-Server
	}

	# Worker response headers include CSP, so revalidate them independently of
	# the content-hashed JavaScript cache lifetime.
	@hash_worker path /assets/sha256.worker-*.js
	header @hash_worker Cache-Control "public, max-age=0, must-revalidate"

	handle /v1/admin/meta* {
		reverse_proxy meta-server:8081
	}

	handle /v1/admin* {
		reverse_proxy control-plane:8080
	}

	handle {
		reverse_proxy admin-web:8080
	}
}

# The S3 API hostname is used in browser presigned PUT URLs. Keep the request
# host, path, query, and signed headers unchanged while proxying to MinIO.
{$MINIO_S3_SITE:s3.example.com} {
	header -Server
	reverse_proxy minio:9000
}

# Public downloads use a separate hostname and expose only immutable objects
# under the server-owned downloads/ prefix. The MinIO console remains private.
{$DOWNLOADS_SITE:downloads.example.com} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}

	@download_objects {
		method GET HEAD
		path /{$DOWNLOAD_S3_BUCKET:project-rebound-downloads}/downloads/*
	}
	handle @download_objects {
		reverse_proxy minio:9000
	}
	handle {
		respond 404
	}
}
