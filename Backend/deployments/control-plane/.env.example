# Copy to .env and run scripts/generate-control-plane-env.sh to generate a
# complete secret-bearing file. Never commit .env.
POSTGRES_DB=projectrebound
POSTGRES_USER=projectrebound
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
META_POSTGRES_USER=projectrebound_meta
META_POSTGRES_PASSWORD=CHANGE_ME
META_REDIS_USERNAME=projectrebound-meta
META_REDIS_PASSWORD=CHANGE_ME

# Test/IP mode: http://:80 with PUBLIC_API_HTTP_PORT=8080.
# Production DNS mode: api.example.com with ports 80 and 443 reachable.
PUBLIC_API_SITE=http://:80
ADMIN_WEB_SITE=admin.example.com
MINIO_S3_SITE=s3.example.com
DOWNLOADS_SITE=downloads.example.com
PUBLIC_API_BIND_IP=0.0.0.0
PUBLIC_API_HTTP_PORT=8080
PUBLIC_API_HTTPS_PORT=443
CONTROL_PLANE_ADMIN_PORT=18080
META_SERVER_HTTP_PORT=18082
META_SERVER_LOGIC_PORT=16968
META_LOGIC_PROXY_PROTOCOL=true
META_PROTOCOL_VERSION=1
META_MATCH_RESERVATION_TTL_SECONDS=90
RELAY_CONTROL_BIND_IP=127.0.0.1
RELAY_CONTROL_PORT=9090
RELAY_CONTROL_SERVER_NAMES=control-plane,localhost,relay.example.com

CORS_ALLOWED_ORIGINS=https://game.example.com
ACCESS_TOKEN_KEY_ID=access-signing-key-2026-01
ACCESS_TOKEN_PRIVATE_KEY_BASE64=CHANGE_ME
ACCESS_TOKEN_PUBLIC_KEY_BASE64=CHANGE_ME
DEVICE_FINGERPRINT_KEY_ID=device-fingerprint-v1
DEVICE_FINGERPRINT_HMAC_KEY_BASE64=CHANGE_ME
STEAM_APP_ID=480
STEAM_TICKET_VERIFIER_PATH=/usr/local/bin/decrypt-ticket
STEAM_TICKET_VERIFIER_TIMEOUT_SECONDS=3
STEAM_TICKET_MAXIMUM_AGE_SECONDS=300
STEAM_ENCRYPTED_APP_TICKET_LIBRARY_HOST_PATH=/opt/projectrebound/libsdkencryptedappticket.so
STEAM_ENCRYPTED_APP_TICKET_LIBRARY=/usr/local/lib/libsdkencryptedappticket.so
STEAM_ENCRYPTED_APP_TICKET_KEY_HOST_PATH=/opt/projectrebound/steam-encrypted-app-ticket.key
STEAM_ENCRYPTED_APP_TICKET_KEY_FILE=/run/projectrebound/steam-encrypted-app-ticket.key
INTEGRITY_CHALLENGE_TTL_SECONDS=120
INTEGRITY_MAXIMUM_FAILURES=3
ADMIN_TOKENS=operator=CHANGE_ME
ADMIN_ACCESS_TOKEN_KEY_ID=admin-access-signing-key-2026-01
ADMIN_ACCESS_TOKEN_PRIVATE_KEY_BASE64=CHANGE_ME
ADMIN_ACCESS_TOKEN_PUBLIC_KEY_BASE64=CHANGE_ME
ADMIN_MFA_ENCRYPTION_KEY_BASE64=CHANGE_ME
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME
TURNSTILE_EXPECTED_HOSTNAME=admin.example.com
TURNSTILE_EXPECTED_ACTION=admin_login
GAME_SERVER_CA_CERT_PEM_BASE64=CHANGE_ME
GAME_SERVER_CA_KEY_PEM_BASE64=CHANGE_ME

# P2P BattleLog starts disabled and in shadow mode. Enable only after Launcher
# v3 upload telemetry is healthy; shadow mode never feeds rewards or rankings.
P2P_BATTLELOG_ENABLED=false
P2P_BATTLELOG_SHADOW_MODE=true
P2P_BATTLELOG_POLICY_VERSION=p2p-v1
P2P_BATTLELOG_MAX_REPORT_BYTES=524288
P2P_BATTLELOG_MAX_EVENTS=4096
P2P_BATTLELOG_COLLECTION_DEADLINE_SECONDS=300
P2P_BATTLELOG_HARD_EXPIRY_HOURS=8
P2P_BATTLELOG_CAPABILITY_TTL_HOURS=24
P2P_BATTLELOG_FINALIZER_INTERVAL_SECONDS=5

RELAY_BOOTSTRAP_TOKENS=relay-01=CHANGE_ME
RELAY_CA_CERT_PEM_BASE64=CHANGE_ME
RELAY_CA_KEY_PEM_BASE64=CHANGE_ME
RELAY_TOKEN_KEY_ID=relay-signing-key-2026-01
RELAY_TOKEN_PRIVATE_KEY_BASE64=CHANGE_ME
VNT_SECRET_ENCRYPTION_KEY_BASE64=CHANGE_ME_BASE64_32_BYTE_KEY
VNT_SECRET_ENCRYPTION_KEY_ID=vnt-room-v1
# Semicolon-separated read-only historical keys: old-kid=BASE64_KEY;older-kid=BASE64_KEY
VNT_SECRET_DECRYPTION_KEYS=
VNT_ROOMS_ENABLED=false
VNT_ALLOWED_VNTS_VERSIONS=
VNT_ALLOWED_WRAPPER_VERSIONS=0.1.0
VNT_CREDENTIAL_ROTATION_GRACE_SECONDS=60
VNT_ENROLLMENT_REQUESTS_PER_PLAYER_PER_HOUR=5
VNT_DIRECTORY_REQUESTS_PER_IP_PER_MINUTE=120
VNT_BOOTSTRAP_REQUESTS_PER_PLAYER_PER_MINUTE=30
VNT_HEARTBEAT_REQUESTS_PER_CREDENTIAL_PER_MINUTE=120
VNT_MANAGEMENT_REQUESTS_PER_CREDENTIAL_PER_HOUR=10
VNT_MAX_NODES_PER_PLAYER=3
# Optional staged Ed25519 keys: next-kid=BASE64_PRIVATE_KEY;another-kid=BASE64_PRIVATE_KEY
RELAY_TOKEN_ROTATION_KEYS=
RELAY_MIGRATION_TIMEOUT_SECONDS=45
RELAY_MIGRATION_MAX_ATTEMPTS=3

UPDATE_CDN_BASE_URL=https://cdn.example.com/project-rebound
UPDATE_SIGNING_KEY_ID=update-signing-key-2026-01
UPDATE_SIGNING_PRIVATE_KEY_BASE64=CHANGE_ME
UPDATE_DEFAULT_CHANNEL=stable
UPDATE_MINIMUM_CLIENT_VERSION=1.0.0
UPDATE_REALTIME_URL=wss://api.example.com/v1/realtime/connect
UPDATE_STUN_SERVERS=stun:stun.example.com:3478

# Self-hosted MinIO is the default download storage for the management panel.
# Generate real credentials with scripts/generate-control-plane-env.sh.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z.hotfix.7aa24e772
MINIO_CLIENT_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_CONSOLE_PORT=9001
MINIO_CORS_ALLOWED_ORIGINS=https://admin.example.com
DOWNLOADS_ENABLED=true
DOWNLOAD_S3_ENDPOINT=https://s3.example.com
DOWNLOAD_S3_REGION=us-east-1
DOWNLOAD_S3_BUCKET=project-rebound-downloads
DOWNLOAD_S3_ACCESS_KEY_ID=CHANGE_ME
DOWNLOAD_S3_SECRET_ACCESS_KEY=CHANGE_ME
DOWNLOAD_PUBLIC_BASE_URL=https://downloads.example.com/project-rebound-downloads
DOWNLOAD_ALLOWED_EXTENSIONS=exe,msi,zip,7z,pdf,md,txt,docx
DOWNLOAD_MAX_FILE_BYTES=2147483648
DOWNLOAD_MULTIPART_THRESHOLD_BYTES=67108864
DOWNLOAD_PART_SIZE_BYTES=16777216
DOWNLOAD_UPLOAD_SESSION_TTL_HOURS=24
DOWNLOAD_PRESIGN_TTL_MINUTES=15
DOWNLOAD_VERIFICATION_INTERVAL_SECONDS=5

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
LOG_LEVEL=info

# Override only where proxy.golang.org/sum.golang.org are unavailable.
# Verified mainland-China fallback:
# GOPROXY=https://goproxy.cn,direct
# GOSUMDB=sum.golang.org https://sum.golang.google.cn
