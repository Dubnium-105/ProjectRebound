# Required only for first enrollment. Clear it after identity.json has been
# persisted and recreate the container so the bootstrap token leaves its env.
EDGE_RELAY_BOOTSTRAP_TOKEN=CHANGE_ME

# Temporary compatibility only. Production defaults to v2-only.
EDGE_RELAY_ACCEPT_PROTOCOL_V1=false
EDGE_RELAY_MAX_PAYLOAD_BYTES=1200
EDGE_RELAY_NAT_REBIND_WINDOW_SECONDS=30
EDGE_RELAY_MAX_TOKEN_REPLAY_ENTRIES=4000

# Optional build overrides where official Go endpoints are unavailable.
# GOPROXY=https://goproxy.cn,direct
# GOSUMDB=sum.golang.org https://sum.golang.google.cn
