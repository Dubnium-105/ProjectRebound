environment: production
display_name: relay-hkg-01
region: hkg
zone: hkg-1
provider: self-hosted
software_version: 0.1.0
protocol_version: 2
accept_protocol_v1: false

# HTTPS enrollment/API endpoint exposed by Caddy.
control_plane_url: https://api.example.com
# Private VPN address is preferred; a public address is acceptable because
# this port requires TLS 1.3 mutual authentication.
control_addr: 10.20.0.10:9090
# The current control-plane mTLS certificate has this fixed DNS SAN. Do not
# replace it with the IP address used by control_addr.
control_server_name: control-plane

data_dir: /edge-relay-data
listen_addr: ":8443"
metrics_addr: 127.0.0.1:9100
advertised_endpoints:
  - protocol: UDP
    host: 203.0.113.20
    port: 8443
supported_protocols: [UDP]
max_allocations: 1000
max_egress_bps: 200000000
heartbeat_seconds: 15
control_disconnect_grace_seconds: 600
allocation_idle_seconds: 120
cookie_ttl_seconds: 10
max_datagram_bytes: 1280
max_payload_bytes: 1200
ip_packets_per_second: 300
bind_init_per_second: 20
bind_proof_per_second: 10
invalid_tokens_per_minute: 30
max_allocations_per_ip: 100
max_ip_rate_states: 100000
max_ingress_packets_per_second: 100000
temporary_ban_seconds: 60
max_ingress_mbps: 200
max_memory_mb: 512
degraded_threshold_percent: 70
reject_new_threshold_percent: 85
nat_rebind_window_seconds: 30
max_token_replay_entries: 4000
